# .env da API Gateway (servidor). NUNCA comitar o .env real.
PORT=8090
UNIT_ID=UNIDADE-SP
# Gere com: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SMART40_JWT_SECRET=
SMART40_ALLOWED_ORIGINS=http://localhost:9000,https://smart40-shell.vercel.app
SMART40_SOURCE=mock
MOCK_WS_URL=ws://localhost:8080
MOCK_WS_TOKEN=smart40-token-2026
# Adaptadores reais (quando os grupos entregarem) — exemplos:
# IHM_WS_URL=   IHM_HMAC_KEY=
# UR_WS_URL=    UR_BEARER_TOKEN=
# QR_API_URL=   QR_SCANNER_TOKEN=
# EXP_API_URL=  EXP_OAUTH_CLIENT_ID=  EXP_OAUTH_CLIENT_SECRET=
