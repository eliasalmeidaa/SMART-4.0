# Copie para apps/shell/.env.local (NÃO comitar .env.local)
# Tudo que começa com VITE_ vai para o bundle PÚBLICO: nunca colocar aqui IP da Planta N2 (192.168.x.x),
# usuário/senha do Node-RED ou token real. Credenciais reais ficam só no .env da API Gateway.

# Sprint 2: "gateway" (padrão) = Shell fala com a API Gateway. "mock" = direto no mock (Sprint 1).
VITE_SMART40_MODE=gateway
VITE_SMART40_API_URL=http://localhost:8090
# Token de sala de aula trocado por JWT na gateway (não é credencial real).
VITE_SMART40_WS_TOKEN=aluno-token-grupo1

# Só no modo "mock":
# VITE_SMART40_WS_URL=ws://localhost:8080

# "local" (padrão: módulos do monorepo) | "remote" (só importmap.json)
# VITE_SMART40_MFE_SOURCE=local
